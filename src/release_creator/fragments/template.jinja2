{% set release = "release-" ~ (versiondata.version | replace(".", "-")) %}
<a name="{{ release }}"></a>

## {{ versiondata.version }} ({{ versiondata.date }})

{% for section, _ in sections.items() %}
{% for category, _ in definitions.items() if category in sections[section] %}
{% if sections[section][category] %}
{% set name = definitions[category]["name"] %}
<a name="{{ release }}-{{ name | lower | replace(" ", "-") }}"></a>

### {{ name }}

{% for text, values in sections[section][category].items() %}
{% set missing = [] %}
{% for value in values %}
{% set reference = namespace(found=false) %}
{% for tail in (text ~ "\n" ~ (text | replace("/pull/", "/issues/") | replace(":pr:", ":issue:"))).split(value)[1:] if not tail or not tail[0].isdigit() %}{% set reference.found = true %}{% endfor %}
{% if not reference.found %}{% set _ = missing.append(value) %}{% endif %}{% endfor %}
- {{ text }}{{ (" (" ~ (missing | join(", ")) ~ ")") if missing else "" }}
{% endfor %}

{% endif %}
{% endfor %}
{% endfor %}
