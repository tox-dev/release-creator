{% set release = "release-" + versiondata.version | replace(".", "-") %}
{% set heading = versiondata.version + " (" + versiondata.date + ")" %}
.. _{{ release }}:

{% if top_underline == "*" %}
{{ "*" * (heading | length + 2) }}
 {{ heading }}
{{ "*" * (heading | length + 2) }}
{% else %}
{{ heading }}
{{ top_underline * (heading | length) }}
{% endif %}

{% for section, _ in sections.items() %}
{% for category, _ in definitions.items() if category in sections[section] %}
{% if sections[section][category] %}
{% set name = definitions[category]["name"] %}
.. _{{ release }}-{{ name | lower | replace(" ", "-") }}:

{{ name }}
{{ ("-" if underlines[0] == "=" else underlines[0]) * (name | length) }}

{% for text, values in sections[section][category].items() %}
{% set missing = values | reject("in", text) | reject("in", text | replace("/pull/", "/issues/") | replace(":pr:", ":issue:")) | list %}
- {{ text }}{{ (" (" + (missing | join(", ")) + ")") if missing else "" }}
{% endfor %}

{% endif %}
{% endfor %}
{% endfor %}
