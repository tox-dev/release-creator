{% set release = "release-" ~ (versiondata.version | replace(".", "-")) %}
{% set heading = versiondata.version ~ " (" ~ versiondata.date ~ ")" %}
.. _{{ release }}:

{% if top_underline == "*" %}
{{ "*" * (heading | length + 2) }}
 {{ heading }}
{{ "*" * (heading | length + 2) }}
{% else %}
{{ heading }}
{{ top_underline * (heading | length) }}
{% endif %}

{% for section, _ in sections.items() %}
{% for category, _ in definitions.items() if category in sections[section] %}
{% if sections[section][category] %}
{% set name = definitions[category]["name"] %}
.. _{{ release }}-{{ name | lower | replace(" ", "-") }}:

{{ name }}
{{ underlines[0] * (name | length) }}

{% for text, values in sections[section][category].items() %}
{% set missing = [] %}
{% for value in values %}
{% set reference = namespace(found=false) %}
{% set parts = (text ~ "\n" ~ (text | replace("/pull/", "/issues/") | replace(":pr:", ":issue:"))).split(value) %}
{% for index in range(1, parts|length) if (not parts[index - 1] or not parts[index - 1][-1].isalnum()) and (not parts[index] or not parts[index][0].isdigit()) %}{% set reference.found = true %}{% endfor %}
{% if not reference.found %}{% set _ = missing.append(value) %}{% endif %}{% endfor %}
- {{ text }}{{ (" (" ~ (missing | join(", ")) ~ ")") if missing else "" }}
{% endfor %}

{% endif %}
{% endfor %}
{% endfor %}
